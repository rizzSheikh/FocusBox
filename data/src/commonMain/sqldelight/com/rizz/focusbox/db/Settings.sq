CREATE TABLE Settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    focusMin INTEGER NOT NULL,
    shortBreakMin INTEGER NOT NULL,
    longBreakMin INTEGER NOT NULL,
    longBreakInterval INTEGER NOT NULL,
    notificationsEnabled INTEGER NOT NULL
);

selectSettings:
SELECT * FROM Settings WHERE id = 1;

insertDefaultSettings:
INSERT OR IGNORE INTO Settings(
    id,
    focusMin,
    shortBreakMin,
    longBreakMin,
    longBreakInterval,
    notificationsEnabled
) VALUES (1, 25, 5, 15, 4, 1);

updateTimerDurations:
UPDATE Settings
SET focusMin = ?, shortBreakMin = ?, longBreakMin = ?, longBreakInterval = ?
WHERE id = 1;

updateNotificationsEnabled:
UPDATE Settings SET notificationsEnabled = ? WHERE id = 1;
